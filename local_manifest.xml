        name="vendor_qcom_opensource_data-ipa-cfg-mgr"
        remote="theangelplace"
        revision="lineage-22.0-caf-sm6225" />

    <project
        path="hardware/qcom-caf/sm6225/dataipa"
        name="vendor_qcom_opensource_dataipa"
