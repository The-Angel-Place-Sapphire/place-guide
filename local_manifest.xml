    <project
        path="device/qcom/sepolicy_vndr/sm6225"
        name="device_qcom_sepolicy_vndr"
        remote="theangelplace"
        revision="lineage-23.0-caf-sm6225" />

    <!--
        StatiX-specific removals.

        StatiX's include-caf.xml ships the sm8450 audio stack.  The sm8450
        hardware/qcom-caf subtree is gated off by the os_pickup guards, but
        vendor/qcom/opensource/{pal,agm} are plain projects with no guard, so
        their Android.bp is always parsed.  sapphire needs the sm6225 stack
        above, which defines the same HIDL module names, and Soong fails with
        "module already defined".
    -->
    <remove-project name="android_vendor_qcom_opensource_arpal-lx" />
    <remove-project name="android_vendor_qcom_opensource_agm" />

    <!--
        StatiX's vendor/qcom/opensource/power (branch "vic") is the old
        Android.mk QTI power HAL: it links android.hardware.power-V1-ndk, and
        the Android 16 framework compatibility matrix rejects IPower V1
        ("is deprecated; requires at least 2"), failing the OTA VINTF check.
        It also predates the "qtipower" Soong config namespace that
        device/xiaomi/sapphire/device.mk drives (mode_ext_lib ->
        libpowermode-ext-sapphire, tap_to_wake_node).

        The LineageOS revision is Soong-based, builds against the current
        power AIDL, and reads the qtipower variables the device tree sets.
        Without a usable IPower/default the framework hits a
        NullPointerException in HintManagerService and system_server
        crash-loops until init reboots the device.
    -->
    <remove-project name="android_vendor_qcom_opensource_power" />

    <project
        path="vendor/qcom/opensource/power"
        name="android_vendor_qcom_opensource_power"
        remote="los"
        revision="lineage-23.2" />

</manifest>
