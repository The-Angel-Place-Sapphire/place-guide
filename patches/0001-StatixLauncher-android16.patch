diff --git a/Android.bp b/Android.bp
index 0517b15..dc92edf 100644
--- a/Android.bp
+++ b/Android.bp
@@ -28,6 +28,18 @@ java_import {
 android_app {
     name: "StatixLauncher",
 
+    // AOSP 16 Launcher3 references the Compose facade
+    // (WidgetPickerComposeWrapper, LauncherWidgetPickerModule) from
+    // :launcher-src / :launcher-quickstep-src.  Those symbols come from the
+    // compose defaults, which supply either the enabled or the disabled facade
+    // sources depending on release_enable_compose_in_launcher -- so they are
+    // required even when Compose is off.  Launcher3QuickStepLib applies the
+    // same two defaults; without them dagger fails to resolve the modules.
+    defaults: [
+        "launcher_compose_defaults",
+        "quickstep_compose_defaults",
+    ],
+
     resource_dirs: [
         "res",
     ],
diff --git a/res/layout/launcher.xml b/res/layout/launcher.xml
index df23bc4..c121597 100644
--- a/res/layout/launcher.xml
+++ b/res/layout/launcher.xml
@@ -52,12 +52,46 @@
 
         <!-- Keep these behind the workspace so that they are not visible when
          we go into AllApps -->
-        <com.android.launcher3.pageindicators.PageIndicatorDots
-            android:id="@+id/page_indicator"
+        <!-- AOSP 16 moved the page indicator into a container alongside two
+             PaginationArrow views.  Launcher.setupViews() resolves
+             left/right_indicator_arrow unconditionally and calls
+             setOnClickListener on them, so leaving them out of this overridden
+             layout makes StatixLauncher NPE on every start. -->
+        <LinearLayout
+            android:id="@+id/page_indicator_container"
             android:layout_width="match_parent"
             android:layout_height="@dimen/workspace_page_indicator_height"
             android:layout_gravity="bottom|center_horizontal"
-            android:theme="@style/HomeScreenElementTheme" />
+            android:gravity="center"
+            android:orientation="horizontal">
+
+            <com.android.launcher3.pageindicators.PaginationArrow
+                android:id="@+id/left_indicator_arrow"
+                android:layout_width="@dimen/folder_arrow_touchbox_length"
+                android:layout_height="@dimen/folder_arrow_touchbox_length"
+                android:contentDescription="@string/paginate_left"
+                android:elevation="1dp"
+                android:foreground="@drawable/ic_chevron_left_rounded_700"
+                android:foregroundGravity="center"
+                android:visibility="gone" />
+
+            <com.android.launcher3.pageindicators.PageIndicatorDots
+                android:id="@+id/page_indicator"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:theme="@style/HomeScreenElementTheme" />
+
+            <com.android.launcher3.pageindicators.PaginationArrow
+                android:id="@+id/right_indicator_arrow"
+                android:layout_width="@dimen/folder_arrow_touchbox_length"
+                android:layout_height="@dimen/folder_arrow_touchbox_length"
+                android:contentDescription="@string/paginate_right"
+                android:elevation="1dp"
+                android:foreground="@drawable/ic_chevron_left_rounded_700"
+                android:foregroundGravity="center"
+                android:rotation="180"
+                android:visibility="gone" />
+        </LinearLayout>
 
         <include
             android:id="@+id/drop_target_bar"
